# إعدادات الاتصال بقاعدة بيانات Supabase
# احصل على هذه القيم من لوحة تحكم مشغوع Supabase الخاص بك:
# Project Settings -> API

# عنوان URL الخاص بمشروع Supabase (مطلوب)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# المفتاح العام للعميل (Anon Public Key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# المفتاح السري للخدمة (Service Role Secret Key) - يُستخدم بأمان في الخادم الخلفي فقط
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
